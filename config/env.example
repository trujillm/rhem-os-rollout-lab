# Copy to config/env and fill. Never commit config/env.

# OpenShift / RHEM
export KUBECONFIG=/Users/matrujil/Documents/ipi_installs/matrujil-rhem/auth/kubeconfig
export RHEM_CHART_VERSION=1.3.0
export FLIGHTCTL_API=https://api.flightctl.apps.matrujil-rhem.kni.syseng.devcluster.openshift.com
export FLIGHTCTL_AGENT_API=https://agent-api.flightctl.apps.matrujil-rhem.kni.syseng.devcluster.openshift.com
export OCP_APPS_DOMAIN=apps.matrujil-rhem.kni.syseng.devcluster.openshift.com

# Registry for bootc OS images (operator-controlled Quay repo)
export OS_IMAGE_REPO=quay.io/REPLACE_ME/rhem-os-rollout-lab
export OS_IMAGE_GOOD=${OS_IMAGE_REPO}:good
export OS_IMAGE_BAD=${OS_IMAGE_REPO}:bad
# Optional: containers authfile copied to the device as /etc/ostree/auth.json before Test 1
# digest-pins private Quay (bootc pull secret). Default: $HOME/.config/containers/auth.json
# export REGISTRY_AUTH_FILE=$HOME/.config/containers/auth.json
# Optional Test 1 knobs (see scripts/40-rollout-good.sh):
# export BUILD_APRIME=auto
# export ROLLOUT_TIMEOUT_SEC=2700
# export OS_IMAGE_TARGET=quay.io/REPLACE_ME/rhem-os-rollout-lab@sha256:REPLACE_ME

# Device / AWS
export AWS_REGION=us-east-2
export AWS_PROFILE=default
export EC2_INSTANCE_TYPE=m6i.large
export EC2_KEY_NAME=REPLACE_ME
export EC2_SUBNET_ID=REPLACE_ME
export EC2_SG_ID=REPLACE_ME
# RHEM 1.3 metadata.name is an agent hash; lab id is the alias label.
export DEVICE_NAME=os-rollout-test-01
export DEVICE_ALIAS=os-rollout-test-01
export DEVICE_SSH=ec2-user@REPLACE_ME_PUBLIC_IP
export FLEET_NAME=os-rollout-test

# AMI (scripts/15-build-ami.sh) / instance (scripts/20-provision-ec2.sh) — discovered at
# runtime, never account-specific values committed here. See infra/ec2/README.md.
export AMI_ID=REPLACE_ME
export INSTANCE_ID=REPLACE_ME
# Password for the ec2-user baked into the AMI (sudo requires one on image A — no NOPASSWD wheel
# entry). Generated once by scripts/15-build-ami.sh if unset; never commit the real value.
export EC2_SSH_PASSWORD=REPLACE_ME
